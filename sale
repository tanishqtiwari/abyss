<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tanishq’s Personal Sale</title>

<link href="https://fonts.googleapis.com/css2?family=Creepster&display=swap" rel="stylesheet">

<style>
* { box-sizing: border-box; }

body {
  margin: 0;
  background: radial-gradient(circle at top, #180000, #000 75%);
  color: #f2dada;
  font-family: 'VT323', monospace;
}

/* ===== HEADER ===== */
.header {
  padding: 28px 16px 14px;
  text-align: center;
}

.header h1 {
  font-family: 'Nosifer', cursive;
  font-size: 30px;
  color: #c40000;
  text-shadow:
    2px 2px 0 #300000,
    0 0 8px rgba(255,0,0,0.6);
  position: relative;
}

/* BLOOD DRIP */
.header h1::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 100%;
  width: 5px;
  height: 30px;
  background: linear-gradient(#c40000, transparent);
  animation: drip 2.6s infinite ease-in;
}

@keyframes drip {
  0% { height: 0; opacity: 1; }
  70% { height: 30px; opacity: 1; }
  100% { height: 45px; opacity: 0; }
}

.header p {
  margin-top: 12px;
  font-size: 16px;
  color: #b66;
  letter-spacing: 1px;
}

/* ===== GRID ===== */
.container {
  padding: 18px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18px;
}

/* ===== CARD ===== */
.card {
  background: linear-gradient(180deg, #140000, #050000);
  border: 2px solid #3a0000;
  border-radius: 14px;
  overflow: hidden;
  position: relative;

  /* SAME ANIMATION FOR ALL */
  animation: cursedBreath 3.8s infinite ease-in-out;
}

@keyframes cursedBreath {
  0% {
    transform: scale(1);
    box-shadow: 0 0 6px rgba(120,0,0,0.3);
  }
  50% {
    transform: scale(1.02);
    box-shadow: 0 0 22px rgba(200,0,0,0.55);
  }
  100% {
    transform: scale(1);
    box-shadow: 0 0 6px rgba(120,0,0,0.3);
  }
}

/* HOVER = AGGRESSIVE */
.card:hover {
  animation: hunt 1.2s infinite;
  border-color: #ff0000;
}

@keyframes hunt {
  0% { transform: scale(1) rotate(0deg); }
  50% { transform: scale(1.04) rotate(-0.7deg); }
  100% { transform: scale(1) rotate(0deg); }
}

/* IMAGE */
.image-wrap {
  height: 170px;
  background: #000;
  position: relative;
}

.image-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: contrast(1.15) saturate(0.6) brightness(0.85);
}

/* SCRATCH OVERLAY */
.image-wrap::after {
  content: "";
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(
    -45deg,
    rgba(150,0,0,0.07),
    rgba(150,0,0,0.07) 2px,
    transparent 2px,
    transparent 7px
  );
}

/* BODY */
.card-body {
  padding: 12px;
}

.title {
  font-size: 18px;
  color: #ff4a4a;
  text-shadow: 1px 1px 0 #2a0000;
}

.price {
  margin-top: 6px;
  font-size: 22px;
  color: #ff0000;
}

.sub {
  font-size: 14px;
  color: #aa6666;
}

/* BUY BUTTON */
.buy {
  margin-top: 12px;
  display: block;
  text-align: center;
  padding: 12px;
  background: linear-gradient(180deg, #b30000, #640000);
  color: #fff;
  font-size: 16px;
  text-decoration: none;
  border-radius: 6px;
  border: 1px solid #ff0000;
  letter-spacing: 1px;
}

.buy:hover {
  background: linear-gradient(180deg, #ff0000, #7a0000);
}

/* DESKTOP */
@media (min-width: 768px) {
  .grid {
    grid-template-columns: repeat(4, 1fr);
  }
}
</style>
</head>

<body>

<div class="header">
  <h1>Tanishq’s Personal Item & Services Sale</h1>
  <p>Some items want to be bought.</p>
</div>

<div class="container">
  <div class="grid">

    <div class="card">
      <div class="image-wrap">
        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSegeecsYgD3mPasrU7Yaoyka48mYKO059E6ck8HGMT3NdGXrx9S46xgto&s=10">
      </div>
      <div class="card-body">
        <div class="title">Scented Used Underwears</div>
        <div class="price">₹101.31</div>
        <div class="sub">Exact amount only</div>
        <a class="buy" href="payment.html">TAKE IT</a>
      </div>
    </div>

    <div class="card">
      <div class="image-wrap">
        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQrCfEyo4FndEqayfo1mSQlDgPsgGqENSy7VqDv16oa5A&s=10">
      </div>
      <div class="card-body">
        <div class="title">Frozen Shit(1 week+ old)</div>
        <div class="price">₹246.79</div>
        <div class="sub">Address confirmed later</div>
        <a class="buy" href="payment.html">CLAIM</a>
      </div>
    </div>

    <div class="card">
      <div class="image-wrap">
        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRRa6H7WFJ0dLEpzsJ1oKXHzxB6dQks4hTyPpBLYO0iiw&s=10">
      </div>
      <div class="card-body">
        <div class="title">Vomit + Blood Smoothie</div>
        <div class="price">321.67</div>
        <div class="sub">Address Confirmed Later</div>
        <a class="buy" href="payment.html">ENTER</a>
      </div>
    </div>

<div class="card">
      <div class="image-wrap">
        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRkA_0l0Q5Vqi2GL0KWUfZ2C-PBjYhsYW73Ok7nnL1NiQ&s=10">
      </div>
      <div class="card-body">
        <div class="title">Ass Hair Powder for Healing & Nurture</div>
        <div class="price">₹98.12</div>
        <div class="sub">Address confirmed later</div>
        <a class="buy" href="payment.html">CLAIM</a>
      </div>
    </div>

  </div>
</div>

</body>
</html>
