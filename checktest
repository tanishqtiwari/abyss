<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Apex — Build Better Software</title>
    <style>
        /* Modern CSS Reset & Design Tokens */
        :root {
            --primary: #4f46e5;
            --primary-hover: #4338ca;
            --bg-dark: #0f172a;
            --text-main: #334155;
            --text-muted: #64748b;
            --bg-light: #f8fafc;
            --border: #e2e8f0;
            --radius: 8px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            color: var(--text-main);
            background-color: #ffffff;
            line-height: 1.6;
        }

        /* Container */
        .container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Header / Navbar */
        header {
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(8px);
            z-index: 100;
        }

        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            height: 70px;
        }

        .logo {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--bg-dark);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .logo-dot {
            width: 10px;
            height: 10px;
            background-color: var(--primary);
            border-radius: 50%;
        }

        .nav-links {
            display: flex;
            gap: 20px;
            list-style: none;
        }

        .nav-links a {
            text-decoration: none;
            color: var(--text-muted);
            font-weight: 500;
            transition: color 0.2s;
        }

        .nav-links a:hover {
            color: var(--bg-dark);
        }

        /* Buttons */
        .btn {
            display: inline-block;
            padding: 10px 20px;
            border-radius: var(--radius);
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.2s;
            border: none;
        }

        .btn-primary {
            background-color: var(--primary);
            color: white;
        }

        .btn-primary:hover {
            background-color: var(--primary-hover);
        }

        .btn-outline {
            border: 1px solid var(--border);
            color: var(--text-main);
            background: white;
        }

        .btn-outline:hover {
            background: var(--bg-light);
        }

        /* Hero Section */
        .hero {
            padding: 100px 0 60px;
            text-align: center;
            background: linear-gradient(180deg, var(--bg-light) 0%, #ffffff 100%);
        }

        .hero h1 {
            font-size: 3rem;
            font-weight: 800;
            color: var(--bg-dark);
            margin-bottom: 20px;
            letter-spacing: -1px;
        }

        .hero p {
            font-size: 1.25rem;
            color: var(--text-muted);
            max-width: 600px;
            margin: 0 auto 30px;
        }

        .hero-cta {
            display: flex;
            gap: 15px;
            justify-content: center;
        }

        /* Features Section */
        .features {
            padding: 80px 0;
        }

        .section-title {
            text-align: center;
            margin-bottom: 50px;
        }

        .section-title h2 {
            font-size: 2rem;
            color: var(--bg-dark);
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
        }

        .card {
            padding: 30px;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            transition: box-shadow 0.3s;
        }

        .card:hover {
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
        }

        .card-icon {
            font-size: 2rem;
            margin-bottom: 15px;
        }

        .card h3 {
            font-size: 1.25rem;
            margin-bottom: 10px;
            color: var(--bg-dark);
        }

        .card p {
            color: var(--text-muted);
            font-size: 0.95rem;
        }

        /* Footer */
        footer {
            border-top: 1px solid var(--border);
            padding: 40px 0;
            background-color: var(--bg-light);
            text-align: center;
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        /* Mobile responsiveness */
        @media (max-width: 768px) {
            .hero h1 {
                font-size: 2.2rem;
            }
            .nav-links {
                display: none; /* Simplified for single file example */
            }
        }
    </style>
</head>
<body>

    <!-- Header / Navbar -->
    <header>
        <div class="container">
            <nav>
                <a href="#" class="logo">
                    <div class="logo-dot"></div> Apex
                </a>
                <ul class="nav-links">
                    <li><a href="#features">Features</a></li>
                    <li><a href="#pricing">Pricing</a></li>
                    <li><a href="#about">About</a></li>
                </ul>
                <div>
                    <a href="#" class="btn btn-outline">Log in</a>
                    <a href="#" class="btn btn-primary">Sign Up</a>
                </div>
            </nav>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="hero">
        <div class="container">
            <h1>Build your next big idea, faster.</h1>
            <p>Apex provides the ultimate toolkit for modern developers. Launch scalable applications in minutes, not months.</p>
            <div class="hero-cta">
                <a href="#" class="btn btn-primary" onclick="alert('Welcome! This is a dummy website.')">Get Started Free</a>
                <a href="#" class="btn btn-outline">Watch Demo</a>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="features" id="features">
        <div class="container">
            <div class="section-title">
                <h2>Everything you need to scale</h2>
            </div>
            <div class="grid">
                <div class="card">
                    <div class="card-icon">⚡</div>
                    <h3>Lightning Fast</h3>
                    <p>Optimized for maximum speed and performance out of the box with global edge routing.</p>
                </div>
                <div class="card">
                    <div class="card-icon">🔒</div>
                    <h3>Bank-Grade Security</h3>
                    <p>Built-in encryption and access controls ensure your data stays safe and compliant.</p>
                </div>
                <div class="card">
                    <div class="card-icon">📊</div>
                    <h3>Real-time Analytics</h3>
                    <p>Track user behavior and system performance seamlessly with built-in dashboards.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="container">
            <p>&copy; 2026 Apex, Inc. All rights reserved. (Dummy Website)</p>
        </div>
    </footer>

</body>
</html>
